<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tin Tức Kindle</title>
  <style>
    body { font-family: Georgia, serif; max-width: 680px; margin: 0 auto; padding: 14px; line-height: 1.65; color: #000; background: #fff; font-size: 18px; }
    h1 { font-size: 22px; border-bottom: 2px solid #000; padding-bottom: 6px; margin-bottom: 12px; }
    .nav { margin-bottom: 16px; border-bottom: 1px solid #000; padding-bottom: 10px; }
    .nav button { background: #fff; color: #000; border: 1px solid #000; padding: 6px 10px; margin: 3px 4px 3px 0; font-size: 15px; font-weight: bold; }
    .nav button.active { background: #000; color: #fff; }
    .item { border-bottom: 1px solid #ccc; padding: 12px 0; }
    .item a { color: #000; text-decoration: none; font-weight: bold; font-size: 19px; display: block; }
    .desc { font-size: 15px; color: #222; margin-top: 5px; }
    #reader { display: none; }
    .back-btn { background: #000; color: #fff; border: none; padding: 8px 14px; font-size: 16px; margin-bottom: 14px; font-weight: bold; }
  </style>
</head>
<body>
  <div id="list-view">
    <h1>TIN TỨC TỐI GIẢN</h1>
    <div class="nav" id="nav"></div>
    <div id="feed">Đang tải tin tức...</div>
  </div>

  <div id="reader">
    <button class="back-btn" onclick="closeArticle()">← Quay lại danh sách</button>
    <h2 id="art-title"></h2>
    <div id="art-body"></div>
    <br><button class="back-btn" onclick="closeArticle()">← Quay lại danh sách</button>
  </div>

  <script>
    // Bạn có thể thêm hoặc thay đổi link RSS các báo Việt Nam tại đây
    const FEEDS = [
      { name: "VnExpress", url: "https://vnexpress.net/rss/tin-moi-nhat.rss" },
      { name: "Tuổi Trẻ", url: "https://tuoitre.vn/rss/tin-moi-nhat.rss" },
      { name: "Thanh Niên", url: "https://thanhnien.vn/rss/home.rss" },
      { name: "Tinh Tế", url: "https://tinhte.vn/rss" }
    ];

    let articles = [];
    const navEl = document.getElementById("nav");
    const feedEl = document.getElementById("feed");

    FEEDS.forEach((f, idx) => {
      const btn = document.createElement("button");
      btn.textContent = f.name;
      btn.onclick = () => loadFeed(idx);
      navEl.appendChild(btn);
    });

    async function loadFeed(index) {
      document.querySelectorAll(".nav button").forEach((b, i) => b.classList.toggle("active", i === index));
      feedEl.innerHTML = "Đang tải tin mới nhất...";
      try {
        const api = "https://api.rss2json.com/v1/api.json?rss_url=" + encodeURIComponent(FEEDS[index].url);
        const res = await fetch(api);
        const data = await res.json();
        articles = data.items || [];
        feedEl.innerHTML = articles.map((item, i) => {
          const cleanDesc = item.description.replace(/<[^>]*>?/gm, '').trim();
          return `<div class="item">
            <a href="javascript:void(0)" onclick="openArticle(${i})">${item.title}</a>
            <div class="desc">${cleanDesc}</div>
          </div>`;
        }).join("");
      } catch (e) {
        feedEl.innerHTML = "Không tải được tin. Kiểm tra lại Wi-Fi.";
      }
    }

    function openArticle(i) {
      const item = articles[i];
      document.getElementById("art-title").textContent = item.title;
      // Loại bỏ thẻ ảnh/script nặng, chỉ giữ lại đoạn văn bản
      const cleanText = item.content.replace(/<img[^>]*>/g, "").replace(/<script[\s\S]*?<\/script>/gi, "");
      document.getElementById("art-body").innerHTML = cleanText + `<p><a href="${item.link}">[Mở bài gốc nếu tin bị rút gọn]</a></p>`;
      document.getElementById("list-view").style.display = "none";
      document.getElementById("reader").style.display = "block";
      window.scrollTo(0, 0);
    }

    function closeArticle() {
      document.getElementById("reader").style.display = "none";
      document.getElementById("list-view").style.display = "block";
    }

    loadFeed(0);
  </script>
</body>
</html>
